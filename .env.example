# =========================================================================
# Alexandria National University (ANU) - Faculty of Engineering
# Introduction to Database Systems - Lab 2 & Lab 3
# Environment Configuration Template (Rename this file to .env locally)
# =========================================================================

# Flask Secret Key for signed session cookies & CSRF protection
SECRET_KEY=replace_with_a_secure_random_secret_key_for_anu_lab3

# Application Environment
FLASK_ENV=development
FLASK_DEBUG=1

# Database Backend Selection: 'auto', 'mysql', or 'sqlite'
# - 'auto': Uses MySQL if configured and reachable; otherwise safely falls back to SQLite.
# - 'sqlite': Strictly uses local SQLite database (users.db).
# - 'mysql': Connects directly to MySQL server using credentials below.
DB_TYPE=auto

# MySQL Server Configuration (When DB_TYPE=mysql or running against MySQL)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DB=library
